{
  "$schema": "https://raw.githubusercontent.com/b-at-neu/port/main/schema/port.config.schema.json",
  "tracker": "github",
  "repo": "SGAOperations/aplio",
  "branches": { "integration": "dev", "production": "main" },
  "commands": {
    "bootstrap": ["npm ci", "npm run prisma:generate"],
    "checks": [
      { "run": "npm run prettier:check", "fix": "npm run prettier:fix" },
      { "run": "npm run eslint:check", "fix": null },
      { "run": "npm run tsc:check", "fix": null },
      { "run": "npm run test", "fix": null }
    ],
    "artifacts": "node scripts/port-artifacts.mjs",
    "worktrees": "node scripts/port-worktrees.mjs",
    "budget": "node scripts/port-budget.mjs",
    "tick": null,
    "forensics": null
  },
  "docs": { "engineering": "docs/ENGINEERING.md", "design": "docs/DESIGN.md" },
  "models": {
    "plan": "opus",
    "impl": "sonnet",
    "review": "sonnet",
    "revise": "sonnet"
  },
  "labels": {},
  "modules": { "approvalGate": true, "release": true, "scope": true },
  "release": {
    "versionSource": "package",
    "versionFiles": ["package.json", "package-lock.json"],
    "versionCommand": "npm version {{version}} --no-git-tag-version --allow-same-version",
    "postPublishHook": null
  },
  "reviewCycleCap": 5,
  "budget": { "wallClockMinutes": null },
  "concurrency": { "sharedFiles": [], "overlapThreshold": 2 },
  "sessionRequiredPaths": ["CLAUDE.md", ".claude/**"],
  "extraAllow": [
    "Bash(node scripts/port-artifacts.mjs *)",
    "Bash(node scripts/port-worktrees.mjs *)",
    "Bash(node scripts/port-budget.mjs *)",
    "Bash(npx shadcn@latest *)"
  ]
}
