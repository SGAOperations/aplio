{
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx shadcn *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx shadcn@* *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(egrep)",
      "Bash(egrep *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat)",
      "Bash(cat *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(tail)",
      "Bash(tail *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(cut)",
      "Bash(cut *)",
      "Bash(diff)",
      "Bash(diff *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(echo)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(true)",
      "Bash(true *)",
      "Bash(mkdir -p *)",
      "Edit(**)",
      "Write(**)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",
      "Bash(git push * dev)",
      "Bash(git push origin dev)",
      "Bash(git push *:dev)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",
      "Bash(npx vercel *)",
      "Bash(vercel *)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -delete*)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(* > *)",
      "Bash(* >> *)",
      "Bash(* | tee *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-bash-denial.mjs"
          }
        ]
      }
    ]
  },
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" }
}
