{
  "env": { "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1" },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Skill",
      "Bash(npx shadcn *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx shadcn@* *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(egrep)",
      "Bash(egrep *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(mkdir -p *)",
      "Edit(**)",
      "Write(**)",
      "Read(~/.claude/plugins/**)",
      "Bash(node scripts/port-artifacts.mjs *)",
      "Bash(node scripts/port-worktrees.mjs *)",
      "Bash(node scripts/port-budget.mjs *)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",
      "Bash(git push * dev)",
      "Bash(git push origin dev)",
      "Bash(git push *:dev)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",
      "Bash(npx vercel *)",
      "Bash(vercel *)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -delete*)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(find -exec *)",
      "Bash(find -execdir *)",
      "Bash(find -delete*)",
      "Bash(find -ok *)",
      "Bash(find -okdir *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/log-bash-denial.mjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "port@port": true,
    "context7@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "port": {
      "source": {
        "source": "github",
        "repo": "b-at-neu/port",
        "ref": "v0.3.0"
      },
      "autoUpdate": true
    }
  }
}
