{
  "name": "aplio",
  "version": "1.17.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "eslint:check": "eslint . --max-warnings=0",
    "eslint:fix": "eslint . --fix",
    "tsc:check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "npx tsx --env-file=.env prisma/seed.ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "prepare": "husky && npm run hooks:check",
    "hooks:check": "node scripts/check-hooks.mjs"
  },
  "prisma": {
    "seed": "npx tsx --env-file=.env prisma/seed.ts",
    "backfill:sgauth-ids": "npx tsx --env-file=.env scripts/backfill-sgauth-ids.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@nusgaops/sgauth": "0.2.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/blob": "^2.8.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "posthog-js": "^1.438.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "*",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
